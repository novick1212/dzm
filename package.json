{
  "name": "dzm",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop-pinned markdown notepad for Windows",
  "author": "novick1212",
  "main": "dist/electron/main.js",
  "scripts": {
    "build:renderer": "vite build",
    "build:main": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --external:electron --outdir=dist/electron --format=cjs --sourcemap",
    "build": "npm run build:renderer && npm run build:main",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.novick.dzm",
    "productName": "dzm",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "scripts/desktop-pin.ps1",
        "to": "scripts/desktop-pin.ps1"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "dzm-${version}.exe"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "dependencies": {
    "@types/markdown-it": "^14.2.0",
    "dompurify": "^3.2.4",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1"
  }
}
